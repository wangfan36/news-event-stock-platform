# Optional runtime overrides
NEWS_ALPHA_HOST=127.0.0.1
NEWS_ALPHA_PORT=8000
NEWS_USE_LIVE=0
NEWS_ALPHA_ENABLE_NETWORK_FUNDAMENTALS=0

# Copy this file to .env only if your launcher loads it. Never put a real key in this example file.
# Prefer the process environment over persisting a model key in local SQLite.
NEWS_ALPHA_API_KEY=

# Optional alternative YAML config path.
NEWS_ALPHA_CONFIG=
